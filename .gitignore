# dependencies
node_modules/

# logs
*.log

# SQLite databases (target DBs, sidecars, snapshots) — never commit data.
# Dev/scratch DBs live in ./data by convention; the dir is tracked (.gitkeep)
# but its contents are not.
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db
*.db-wal
*.db-shm
sql-snapshots/
data/*
!data/.gitkeep
!data/README.md

# build output
dist/
client/dist/

# env / secrets
.env
.env.*

# real project registry (hosts/paths are personal); the example is tracked
projects.json

# editor / OS
.DS_Store
.vscode/
.idea/
